--- a/target/linux/sunxi/dts/sun8i-h3-nanopi-r1s-h3.dts
+++ b/target/linux/sunxi/dts/sun8i-h3-nanopi-r1s-h3.dts
@@ -1,7 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0-or-later OR MIT
 
 /dts-v1/;
-#include "sun8i-h3-nanopi.dtsi"
+#include "sun8i-h3-nanopi-r1.dtsi"
 
 / {
 	model = "FriendlyARM NanoPi R1S-H3";
@@ -9,6 +9,44 @@
 
 	aliases {
 		serial0 = &uart0;
+		ethernet0 = &emac;
+		ethernet1 = &rtl8153;
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led-sys {
+			label = "nanopi-r1:green:sys";
+			gpios = <&pio 0 10 GPIO_ACTIVE_HIGH>; /* PA10 */
+			linux,default-trigger = "heartbeat";
+		};
+
+		led-lan {
+			label = "nanopi-r1:green:lan";
+			gpios = <&pio 0 9 GPIO_ACTIVE_HIGH>; /* PA9 */
+		};
+
+		led-wan {
+			label = "nanopi-r1:green:wan";
+			gpios = <&pio 6 11 GPIO_ACTIVE_HIGH>; /* PG11 */
+		};
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		key-reset {
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&r_pio 0 3 GPIO_ACTIVE_LOW>; /* PL3 */
+		};
+
+		key-recovery {
+			label = "recovery";
+			linux,code = <KEY_WPS_BUTTON>;
+			gpios = <&r_pio 0 4 GPIO_ACTIVE_LOW>; /* PL4 */
+		};
 	};
 
 	reg_vcc3v3: vcc3v3 {
@@ -16,6 +54,61 @@
 		regulator-name = "vcc3v3";
 		regulator-min-microvolt = <3300000>;
 		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+	};
+
+	/* RTL8211E PHY 供电使能 */
+	reg_gmac_3v3: gmac-3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "gmac-3v3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&pio 3 6 GPIO_ACTIVE_HIGH>; /* PD6 */
+		enable-active-high;
+		regulator-always-on;
+	};
+
+	/* RTL8189ETV WiFi 供电 */
+	vdd_wifi: vdd-wifi {
+		compatible = "regulator-fixed";
+		regulator-name = "vdd-wifi";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&r_pio 0 7 GPIO_ACTIVE_HIGH>; /* PL7 */
+		enable-active-high;
+	};
+};
+
+&emac {
+	phy-handle = <&ext_rgmii_phy>;
+	phy-mode = "rgmii-id";
+	phy-supply = <&reg_gmac_3v3>;
+	status = "okay";
+};
+
+&mdio {
+	ext_rgmii_phy: ethernet-phy@1 {
+		compatible = "ethernet-phy-ieee802.3-c22";
+		reg = <1>;
+		reset-gpios = <&pio 3 14 GPIO_ACTIVE_LOW>; /* PD14 */
+		reset-assert-us = <10000>;
+		reset-deassert-us = <50000>;
+	};
+};
+
+/* SDIO1 - RTL8189ETV */
+&mmc1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&mmc1_pins>;
+	vmmc-supply = <&vcc3v3>;
+	vqmmc-supply = <&vcc3v3>;
+	mmc-pwrseq = <&wifi_pwrseq>;
+	bus-width = <4>;
+	non-removable;
+	status = "okay";
+
+	rtl8189etv: wifi@1 {
+		reg = <1>;
 	};
 };
